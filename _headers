# Cloudflare Pages cache headers
# Static assets — immutable, 1 year cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/hero.avif
  Cache-Control: public, max-age=31536000, immutable

/doctor.avif
  Cache-Control: public, max-age=31536000, immutable

/logo.png
  Cache-Control: public, max-age=31536000, immutable

/logo-dark.png
  Cache-Control: public, max-age=31536000, immutable

# HTML — short cache, must revalidate so updates ship fast
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
